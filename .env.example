# Browser-safe identifier for the Rive-owned Sanity project.
NEXT_PUBLIC_SANITY_PROJECT_ID=9vajygee

# Browser-safe Sanity dataset name. Production is currently the only confirmed dataset.
NEXT_PUBLIC_SANITY_DATASET=production

# Pinned API date used by Sanity queries. Use an explicit YYYY-MM-DD value.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-27

# Server-only token for authenticated preview reads, if later approved.
# Never prefix this variable with NEXT_PUBLIC_ and never commit a real value.
SANITY_API_READ_TOKEN=

# staging | production. Controls indexing and metadata safeguards. Defaults to
# non-indexable when absent or set to anything other than "production".
SITE_ENV=staging

# Server-only Resend configuration for the Connect form. Never prefix these
# variables with NEXT_PUBLIC_ and never commit real values.
CONNECT_DELIVERY_ENABLED=false
RESEND_API_KEY=
CONNECT_FROM_EMAIL=
CONNECT_TO_EMAIL=
